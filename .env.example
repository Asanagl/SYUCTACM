# Web 映射端口 (默认为 3000)
PORT=3000

# PostgreSQL 配置
POSTGRES_USER=syuctacm
POSTGRES_PASSWORD=syuctacm_secret
POSTGRES_DB=syuctacm
POSTGRES_PORT=5432

# 后端配置
SERVER_PORT=8080
DATABASE_URL=postgres://syuctacm:syuctacm_secret@postgres:5432/syuctacm?sslmode=disable
JWT_SECRET=syuctacm_super_secret_jwt_key_change_in_production
CORS_ALLOW_ORIGINS=*
